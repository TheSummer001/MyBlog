#rightMenu.js-pjax
    .rightMenu-group.rightMenu-small
        button.rightMenu-item(type="button" data-rmf-action="historyBack" aria-label="后退")
            i.fa.fa-arrow-left
        button.rightMenu-item(type="button" data-rmf-action="historyForward" aria-label="前进")
            i.fa.fa-arrow-right
        button.rightMenu-item(type="button" data-rmf-action="reload" aria-label="刷新")
            i.fa.fa-refresh
        button.rightMenu-item(type="button" data-rmf-action="scrollToTop" aria-label="回到顶部")
            i.fa.fa-arrow-up
    .rightMenu-group.rightMenu-line.hide#menu-text
        button.rightMenu-item(type="button" data-rmf-action="copySelect")
            i.fa.fa-copy
            span='复制'
        button.rightMenu-item(type="button" data-rmf-action="searchSelection")
            i.fa.fa-search
            span='百度搜索'
    .rightMenu-group.rightMenu-line.hide#menu-selection-link
        button.rightMenu-item(type="button" data-rmf-action="openSelection")
            i.fa.fa-link
            span='转到链接'
    .rightMenu-group.rightMenu-line.hide#menu-paste
        button.rightMenu-item(type="button" data-rmf-action="paste")
            i.fa.fa-copy
            span='粘贴'
    .rightMenu-group.rightMenu-line.hide#menu-post
        a.rightMenu-item(href="#post-comment")
            i.fas.fa-comment
            span='空降评论'
        button.rightMenu-item(type="button" data-rmf-action="copyWordsLink")
            i.fa.fa-link
            span='复制本文地址'
    .rightMenu-group.rightMenu-line.hide#menu-to
        button.rightMenu-item(type="button" data-rmf-action="openWithNewTab")
            i.fa.fa-window-restore
            span='新窗口打开'
        button.rightMenu-item(type="button" data-rmf-action="open")
            i.fa.fa-link
            span='转到链接'
        button.rightMenu-item(type="button" data-rmf-action="copyLink")
            i.fa.fa-copy
            span='复制链接'
    .rightMenu-group.rightMenu-line.hide#menu-img
        button.rightMenu-item(type="button" data-rmf-action="saveAs")
            i.fa.fa-download
            span='保存图片'
        button.rightMenu-item(type="button" data-rmf-action="openWithNewTab")
            i.fa.fa-window-restore
            span='在新窗口打开'
        button.rightMenu-item(type="button" data-rmf-action="copyLink")
            i.fa.fa-copy
            span='复制图片链接'
    .rightMenu-group.rightMenu-line
        a.rightMenu-item(href="/")
            i.fa.fa-home
            span='回到首页'
        button.rightMenu-item(type="button" data-rmf-action="toggleTheme")
            i.fa.fa-moon
            span='昼夜切换'
        button.rightMenu-item(type="button" data-rmf-action="changeMouseMode")
            i.fa.fa-mouse
            span='系统右键'
        button.rightMenu-item(type="button" data-rmf-action="fullScreen")
            i.fas.fa-expand
            span='切换全屏'
        button.rightMenu-item(type="button" data-rmf-action="print")
            i.fa-solid.fa-print
            span='打印页面'