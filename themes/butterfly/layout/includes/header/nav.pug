nav#nav
  span#blog-info
    if theme.portal && theme.portal.enable
      a.nav-portal-link(href=theme.portal.url title=theme.portal.name)
        span=theme.portal.name
        i.fas.fa-chevron-right
    else
      a.nav-site-title(href=url_for('/'))
        if theme.nav.logo
          img.site-icon(src=url_for(theme.nav.logo) alt='Logo')
        if theme.nav.display_title
          span.site-name=config.title
    if globalPageType === 'post' && theme.nav.display_post_title
      a.nav-page-title(href=url_for('/') title=_p('post.back_to_home') aria-label=_p('post.back_to_home'))
        span.site-name=(page.title || config.title)
        span.site-name
          i.fa-solid.fa-circle-arrow-left
          span= '  ' + _p('post.back_to_home')

  #menus
    if theme.darkmode.enable && theme.darkmode.button
      button#nav-darkmode-toggle(type='button' aria-label='切换昼夜模式' title='切换昼夜模式')
        i.fas.fa-sun
    if theme.search.use
      #search-button
        span.site-page.social-icon.search
          i.fas.fa-search.fa-fw
          span= ' ' + _p('search.title')
    if theme.menu
      != partial('includes/header/menu_item', {}, {cache: true})

      #toggle-menu
        span.site-page
          i.fas.fa-bars.fa-fw
